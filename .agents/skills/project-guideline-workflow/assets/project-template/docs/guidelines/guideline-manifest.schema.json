{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "title",
    "entry_path",
    "entry_template_path",
    "agent_instructions_template_path",
    "semantic_baseline",
    "profiles",
    "capabilities",
    "capability_dependencies",
    "task_reading",
    "critical_contracts",
    "modules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "entry_path": { "const": "docs/guidelines/README.md" },
    "entry_template_path": {
      "const": "docs/guidelines/entry-template.md"
    },
    "agent_instructions_template_path": {
      "const": "docs/guidelines/AGENTS.template.md"
    },
    "semantic_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "lines", "meaning"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "lines": { "type": "integer", "minimum": 1 },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "$ref": "#/$defs/uniqueStrings" },
        "optional": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "capabilities": { "$ref": "#/$defs/uniqueStrings" },
    "capability_dependencies": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/uniqueStrings" }
    },
    "task_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always", "rules", "dependencies"],
      "properties": {
        "always": { "$ref": "#/$defs/uniqueStrings" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/uniqueStrings" }
        },
        "rules": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/uniqueStrings" }
        }
      }
    },
    "critical_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_response_envelope",
        "project_book_documentation",
        "database_documentation",
        "ui_choice_controls",
        "ui_copy",
        "ui_density",
        "ui_audience_projection",
        "verification_scope",
        "verification_claim"
      ],
      "properties": {
        "project_book_documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "manifest_driven",
            "minimum_content_enforced",
            "complete_state_transition_coverage",
            "traceability_required"
          ],
          "properties": {
            "rule_id": { "const": "DOC-BOOK-001" },
            "manifest_driven": { "const": true },
            "minimum_content_enforced": { "const": true },
            "complete_state_transition_coverage": { "const": true },
            "traceability_required": { "const": true }
          }
        },
        "database_documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "canonical_schema_reconciliation",
            "all_tables_and_columns",
            "per_table_behavior_contract",
            "executable_data_check"
          ],
          "properties": {
            "rule_id": { "const": "DATA-DOC-001" },
            "canonical_schema_reconciliation": { "const": true },
            "all_tables_and_columns": { "const": true },
            "per_table_behavior_contract": { "const": true },
            "executable_data_check": { "const": true }
          }
        },
        "api_response_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top_level_fields",
            "endpoint_specific_field",
            "success_code",
            "handled_http_status",
            "unexpected_http_status",
            "extra_top_level_fields"
          ],
          "properties": {
            "top_level_fields": {
              "type": "array",
              "prefixItems": [
                { "const": "success" },
                { "const": "code" },
                { "const": "message" },
                { "const": "data" },
                { "const": "request_id" }
              ],
              "items": false,
              "minItems": 5,
              "maxItems": 5
            },
            "endpoint_specific_field": { "const": "data" },
            "success_code": { "const": 0 },
            "handled_http_status": { "const": 200 },
            "unexpected_http_status": { "const": 500 },
            "extra_top_level_fields": { "const": "forbidden" }
          }
        },
        "ui_choice_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "select_max_options",
            "combobox_min_options",
            "combobox_for_remote_catalogs",
            "combobox_for_name_or_code_lookup"
          ],
          "properties": {
            "rule_id": { "const": "UI-CONTROL-001" },
            "select_max_options": { "const": 9 },
            "combobox_min_options": { "const": 10 },
            "combobox_for_remote_catalogs": { "const": true },
            "combobox_for_name_or_code_lookup": { "const": true }
          }
        },
        "ui_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "implementation_details_forbidden",
            "policy_narration_forbidden_by_default",
            "complete_rendered_copy_review",
            "canonical_actor_scope_vocabulary",
            "raw_or_humanized_technical_keys_forbidden",
            "competing_synonyms_rejected"
          ],
          "properties": {
            "rule_id": { "const": "UI-COPY-001" },
            "implementation_details_forbidden": { "const": true },
            "policy_narration_forbidden_by_default": { "const": true },
            "complete_rendered_copy_review": { "const": true },
            "canonical_actor_scope_vocabulary": { "const": true },
            "raw_or_humanized_technical_keys_forbidden": { "const": true },
            "competing_synonyms_rejected": { "const": true }
          }
        },
        "ui_density": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "default_density",
            "phone_touch_target_min_css_px",
            "adjacent_target_separation_min_css_px",
            "desktop_action_width"
          ],
          "properties": {
            "rule_id": { "const": "UI-DENSITY-001" },
            "default_density": { "const": "compact" },
            "phone_touch_target_min_css_px": { "const": 44 },
            "adjacent_target_separation_min_css_px": { "const": 8 },
            "desktop_action_width": { "const": "natural" }
          }
        },
        "ui_audience_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "server_authoritative",
            "complete_observable_surface",
            "shared_components_permission_neutral",
            "filter_options_from_authorized_scope",
            "counts_and_facets_scope_projected",
            "cross_boundary_identity_default",
            "direct_request_no_leak_tests"
          ],
          "properties": {
            "rule_id": { "const": "UI-AUDIENCE-001" },
            "server_authoritative": { "const": true },
            "complete_observable_surface": { "const": true },
            "shared_components_permission_neutral": { "const": true },
            "filter_options_from_authorized_scope": { "const": true },
            "counts_and_facets_scope_projected": { "const": true },
            "cross_boundary_identity_default": { "const": "redacted" },
            "direct_request_no_leak_tests": { "const": true }
          }
        },
        "verification_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "default_mode",
            "safe_fallback_requires_review",
            "unrelated_suites_forbidden",
            "changed_evidence_binding",
            "commit_only_transition_preserves_evidence",
            "full_release_revision_binding_strict",
            "source_change_scope",
            "source_change_forces_full_regression",
            "multi_module_scope",
            "release_scope",
            "release_candidate_forces_full_regression",
            "release_base_revision_required",
            "release_target_environment_required",
            "release_predeployment_baseline_required",
            "release_postdeployment_baseline_required",
            "release_unrelated_suites_forbidden",
            "full_regression_triggers"
          ],
          "properties": {
            "rule_id": { "const": "VERIFY-SCOPE-001" },
            "default_mode": { "const": "risk-scoped" },
            "safe_fallback_requires_review": { "const": true },
            "unrelated_suites_forbidden": { "const": true },
            "changed_evidence_binding": { "const": "maintained-content-fingerprint" },
            "commit_only_transition_preserves_evidence": { "const": true },
            "full_release_revision_binding_strict": { "const": true },
            "source_change_scope": { "const": "changed-module-boundaries-and-direct-consumers" },
            "source_change_forces_full_regression": { "const": false },
            "multi_module_scope": { "const": "union-of-focused-slices" },
            "release_scope": { "const": "candidate-diff-plus-universal-release-baseline" },
            "release_candidate_forces_full_regression": { "const": false },
            "release_base_revision_required": { "const": true },
            "release_target_environment_required": { "const": true },
            "release_predeployment_baseline_required": { "const": true },
            "release_postdeployment_baseline_required": { "const": true },
            "release_unrelated_suites_forbidden": { "const": true },
            "full_regression_triggers": {
              "type": "array",
              "prefixItems": [
                { "const": "explicit-request" },
                { "const": "initial-release-or-missing-baseline" },
                { "const": "cross-cutting-change" },
                { "const": "systemic-evidence" },
                { "const": "unbounded-impact" }
              ],
              "items": false,
              "minItems": 5,
              "maxItems": 5
            }
          }
        },
        "verification_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "claim_unit",
            "binary_lead_required",
            "absolute_zero_defect_claim_forbidden",
            "scope_complete_requires_zero_open_boundaries",
            "incomplete_claim"
          ],
          "properties": {
            "rule_id": { "const": "VERIFY-CLAIM-001" },
            "claim_unit": { "const": "declared-finite-scope" },
            "binary_lead_required": { "const": true },
            "absolute_zero_defect_claim_forbidden": { "const": true },
            "scope_complete_requires_zero_open_boundaries": { "const": true },
            "incomplete_claim": { "const": "not_verified" }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "title",
          "activation",
          "start_marker",
          "end_before"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^GDL-[0-9]{3}$" },
          "path": { "type": "string", "pattern": "^docs/guidelines/modules/.+\\.md$" },
          "title": { "type": "string", "minLength": 1 },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "values"],
            "properties": {
              "kind": {
                "enum": ["always", "profile-any", "capability-any"]
              },
              "values": { "$ref": "#/$defs/uniqueStrings" }
            }
          },
          "start_marker": { "type": ["string", "null"] },
          "end_before": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
